# XPGAMPP MySQL 9.2.0 Community Server Configuration
[client]
port = 3306
socket = /home/user/hosting/var/run/mysqld.sock
default-character-set = utf8mb4

[mysqld]
user = mysql
port = 3306
bind-address = 0.0.0.0
datadir = /home/user/hosting/var/lib/mysql
socket = /home/user/hosting/var/run/mysqld.sock
pid-file = /home/user/hosting/var/run/mysqld.pid

# Character Set & Collation (MySQL 9.2 Default)
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# InnoDB Storage Engine Tuning
default-storage-engine = InnoDB
innodb_buffer_pool_size = 512M
innodb_redo_log_capacity = 128M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1

# Connections & Buffers
max_connections = 200
max_allowed_packet = 64M
table_open_cache = 2000
thread_cache_size = 16

# Logging
log_error = /home/user/hosting/var/log/mysql_error.log
slow_query_log = 1
slow_query_log_file = /home/user/hosting/var/log/mysql_slow.log
long_query_time = 1.0
